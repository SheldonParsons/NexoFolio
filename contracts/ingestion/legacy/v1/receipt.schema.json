{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_index": {
            "type": "integer",
            "minimum": 0
          },
          "record_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "ignored",
              "rejected"
            ]
          },
          "reason_code": {
            "type": "string",
            "maxLength": 64
          },
          "retryable": {
            "type": "boolean"
          },
          "ingestion_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "record_index",
          "record_id",
          "status",
          "reason_code",
          "retryable",
          "ingestion_id",
          "replayed"
        ]
      },
      "maxItems": 50
    },
    "environment": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
            }
          },
          "required": [
            "id",
            "name"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "batch_id",
    "results",
    "environment"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
