{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2"
      ]
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "instance_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "instance_id"
      ]
    },
    "records": {
      "type": "array",
      "items": {},
      "maxItems": 50,
      "minItems": 1
    },
    "environment": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
            }
          },
          "required": [
            "name"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "batch_id",
    "project_id",
    "environment",
    "source",
    "records"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
