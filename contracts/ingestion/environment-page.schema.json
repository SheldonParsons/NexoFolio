{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "total": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "items",
    "page",
    "limit",
    "total"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
