{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2"
      ]
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "instance_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "instance_id"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Record"
      },
      "maxItems": 50,
      "minItems": 1
    },
    "environment": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
            }
          },
          "required": [
            "name"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "batch_id",
    "project_id",
    "environment",
    "source",
    "records"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Headers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "page-visible",
            "complete",
            "truncated",
            "unreadable"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "maxLength": 8192
              },
              {
                "type": "string",
                "maxLength": 65536
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "maxItems": 256
        }
      },
      "required": [
        "state",
        "entries"
      ]
    },
    "Body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "none",
            "complete",
            "truncated",
            "unreadable",
            "timeout"
          ]
        },
        "encoding": {
          "type": "string",
          "enum": [
            "text",
            "base64",
            "none"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 1500000
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "state",
        "encoding",
        "content",
        "bytes"
      ]
    },
    "HttpExchange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "maxLength": 16384
            },
            "url_truncated": {
              "type": "boolean"
            },
            "method": {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "HEAD",
                "OPTIONS",
                "CONNECT",
                "TRACE"
              ]
            },
            "headers": {
              "$ref": "#/$defs/Headers"
            },
            "body": {
              "$ref": "#/$defs/Body"
            }
          },
          "required": [
            "url",
            "url_truncated",
            "method",
            "headers",
            "body"
          ]
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "complete",
                "truncated",
                "unreadable",
                "failed",
                "timeout"
              ]
            },
            "status": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "type": "string",
              "maxLength": 16384
            },
            "headers": {
              "$ref": "#/$defs/Headers"
            },
            "body": {
              "$ref": "#/$defs/Body"
            }
          },
          "required": [
            "state",
            "status",
            "url",
            "headers",
            "body"
          ]
        },
        "source_page": {
          "type": "string",
          "maxLength": 16384
        },
        "transport": {
          "type": "string",
          "enum": [
            "xhr",
            "fetch",
            "other"
          ]
        },
        "frame": {
          "type": "string",
          "enum": [
            "page",
            "iframe",
            "other"
          ]
        }
      },
      "required": [
        "request",
        "response"
      ]
    },
    "Record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "http_exchange"
          ]
        },
        "payload_version": {
          "type": "string",
          "enum": [
            "1"
          ]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "$ref": "#/$defs/HttpExchange"
        }
      },
      "required": [
        "record_id",
        "kind",
        "payload_version",
        "captured_at",
        "payload"
      ]
    }
  }
}
