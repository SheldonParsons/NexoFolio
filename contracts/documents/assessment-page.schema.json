{
  "$defs": {
    "AssessmentKind": {
      "enum": [
        "duplicate",
        "enrichment",
        "difference",
        "insufficient"
      ],
      "type": "string"
    },
    "ObservationAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructuralAssessment"
            },
            {
              "type": "null"
            }
          ],
          "description": "None means historical data not assessed by this rule; it never means duplicate."
        },
        "base_revision_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "environment_id": {
          "format": "uuid",
          "type": "string"
        },
        "extractor_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "incoming_definition": true,
        "ingestion_id": {
          "description": "Source of the incoming structure, not a claim that new fields belong to base_revision_id.",
          "format": "uuid",
          "type": "string"
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "interface_id",
        "environment_id",
        "ingestion_id"
      ],
      "type": "object"
    },
    "StructuralAssessment": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/AssessmentKind"
          },
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/StructuralFinding"
          },
          "type": "array"
        },
        "initial": {
          "type": "boolean"
        },
        "rule_version": {
          "type": "string"
        }
      },
      "required": [
        "rule_version",
        "initial",
        "categories",
        "findings"
      ],
      "type": "object"
    },
    "StructuralFinding": {
      "additionalProperties": false,
      "properties": {
        "before": true,
        "kind": {
          "$ref": "#/$defs/AssessmentKind"
        },
        "location": {
          "type": "string"
        },
        "observed": true,
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "location",
        "path",
        "reason"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ObservationAssessment"
      },
      "type": "array"
    },
    "limit": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "page": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "total": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "page",
    "limit",
    "total"
  ],
  "title": "ObservationAssessmentPage",
  "type": "object"
}
