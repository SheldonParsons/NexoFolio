{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ObservedDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extractor_version": {
          "const": "observed-http-1"
        },
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "in": {
                    "enum": [
                      "query",
                      "path"
                    ]
                  },
                  "observed_schema": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "name",
                  "in",
                  "observed_schema"
                ]
              }
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "observed_schema": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "name",
                  "observed_schema"
                ]
              }
            },
            "body": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "const": "none"
                    },
                    "media_type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "state",
                    "media_type"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "type": "string"
                    },
                    "media_type": {
                      "type": "string"
                    },
                    "observed_schema": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "state",
                    "media_type",
                    "observed_schema"
                  ]
                }
              ]
            }
          },
          "required": [
            "parameters",
            "headers",
            "body"
          ]
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "capture_state": {
              "type": "string"
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "observed_schema": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "name",
                  "observed_schema"
                ]
              }
            },
            "body": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "const": "none"
                    },
                    "media_type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "state",
                    "media_type"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "type": "string"
                    },
                    "media_type": {
                      "type": "string"
                    },
                    "observed_schema": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "state",
                    "media_type",
                    "observed_schema"
                  ]
                }
              ]
            }
          },
          "required": [
            "status",
            "capture_state",
            "headers",
            "body"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "extractor_version",
        "method",
        "path",
        "request",
        "response",
        "limitations"
      ]
    },
    "InterfaceCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface_id": {
          "type": "string",
          "format": "uuid"
        },
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "environment_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "const": "observed"
        },
        "classification": {
          "enum": [
            "unclassified",
            "classified"
          ]
        },
        "pending_difference_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "interface_id",
        "method",
        "path",
        "environment_id",
        "revision_id",
        "state",
        "classification",
        "pending_difference_count"
      ]
    },
    "InterfacePage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InterfaceCard"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "environment_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "items",
        "total",
        "page",
        "limit",
        "environment_id"
      ]
    },
    "InterfaceDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ]
        },
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "const": "observed"
        },
        "classification": {
          "enum": [
            "unclassified",
            "classified"
          ]
        },
        "definition": {
          "$ref": "#/$defs/ObservedDefinition"
        },
        "origin_ingestion_id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "pending_difference_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "interface_id",
        "project_id",
        "environment",
        "method",
        "path",
        "revision_id",
        "state",
        "classification",
        "definition",
        "origin_ingestion_id",
        "created_at",
        "pending_difference_count"
      ]
    },
    "ObservationCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ingestion_id": {
          "type": "string",
          "format": "uuid"
        },
        "outcome": {
          "enum": [
            "created",
            "unchanged",
            "difference_recorded"
          ]
        },
        "difference_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "compared_revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ingestion_id",
        "outcome",
        "difference_id",
        "compared_revision_id",
        "processed_at"
      ]
    },
    "ObservationPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObservationCard"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "items",
        "total",
        "page",
        "limit"
      ]
    },
    "ObservationDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ingestion_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "environment_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "pending",
            "processing",
            "completed",
            "failed"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "interface_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "created",
                "unchanged",
                "difference_recorded"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "compared_revision_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "difference_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposed_definition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservedDefinition"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_record": {
          "type": [
            "object",
            "null"
          ],
          "description": "原始记录；已过临时保留期且未被引用时为 null。"
        }
      },
      "required": [
        "ingestion_id",
        "project_id",
        "environment_id",
        "status",
        "attempts",
        "error_code",
        "interface_id",
        "outcome",
        "compared_revision_id",
        "difference_id",
        "proposed_definition",
        "raw_record"
      ]
    }
  }
}
