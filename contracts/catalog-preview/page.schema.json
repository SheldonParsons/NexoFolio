{
  "$defs": {
    "CatalogPreviewListItem": {
      "description": "Public read-only HTTP views. Administrative create/run methods are not exposed.",
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "type": "string"
        },
        "directory_count": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "interface_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "snapshot_at": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PreviewStatus"
        },
        "structurally_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "task_id": {
          "format": "uuid",
          "type": "string"
        },
        "unclassified_count": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "task_id",
        "candidate_id",
        "status",
        "snapshot_at",
        "interface_count"
      ],
      "type": "object"
    },
    "PreviewStatus": {
      "enum": [
        "pending",
        "running",
        "ready",
        "rejected",
        "failed"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/CatalogPreviewListItem"
      },
      "type": "array"
    },
    "limit": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "page": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "total": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "total",
    "page",
    "limit"
  ],
  "title": "CatalogPreviewPage",
  "type": "object"
}
