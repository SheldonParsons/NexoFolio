{
  "$defs": {
    "CatalogEnvironment": {
      "additionalProperties": false,
      "properties": {
        "definition": true,
        "environment_id": {
          "format": "uuid",
          "type": "string"
        },
        "environment_name": {
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "environment_id",
        "environment_name",
        "revision_id",
        "definition"
      ],
      "type": "object"
    },
    "CatalogInterface": {
      "additionalProperties": false,
      "properties": {
        "environments": {
          "items": {
            "$ref": "#/$defs/CatalogEnvironment"
          },
          "type": "array"
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "recognized_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "interface_id",
        "method",
        "path",
        "environments"
      ],
      "type": "object"
    },
    "CatalogSnapshot": {
      "additionalProperties": false,
      "properties": {
        "interfaces": {
          "items": {
            "$ref": "#/$defs/CatalogInterface"
          },
          "type": "array"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        },
        "project_name": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "project_name",
        "interfaces"
      ],
      "type": "object"
    },
    "DirectoryCandidate": {
      "additionalProperties": false,
      "properties": {
        "assignments": {
          "items": {
            "$ref": "#/$defs/PreviewAssignment"
          },
          "type": "array"
        },
        "merge_groups": {
          "items": {
            "$ref": "#/$defs/InterfaceMergeGroup"
          },
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/PreviewNode"
          },
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "assignments"
      ],
      "type": "object"
    },
    "DirectoryCounts": {
      "properties": {
        "direct_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "directory_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "directory_id",
        "direct_interfaces"
      ],
      "type": "object"
    },
    "GeneratorInfo": {
      "properties": {
        "adapter": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "prompt_sha256": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "model",
        "prompt_version",
        "prompt_sha256"
      ],
      "type": "object"
    },
    "InterfaceMergeGroup": {
      "additionalProperties": false,
      "properties": {
        "member_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "path_template": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "representative_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "representative_id",
        "member_ids",
        "path_template",
        "reason"
      ],
      "type": "object"
    },
    "PathIdentity": {
      "properties": {
        "parameters": {
          "items": {
            "$ref": "#/$defs/PathParameter"
          },
          "type": "array"
        },
        "rule_version": {
          "type": "string"
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
        "rule_version",
        "template",
        "parameters"
      ],
      "type": "object"
    },
    "PathParameter": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/PathParameterKind"
        },
        "name": {
          "type": "string"
        },
        "segment_index": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "segment_index",
        "kind"
      ],
      "type": "object"
    },
    "PathParameterKind": {
      "enum": [
        "uuid",
        "hex32",
        "hex64",
        "integer"
      ],
      "type": "string"
    },
    "PreviewAssignment": {
      "additionalProperties": false,
      "properties": {
        "directory_id": {
          "description": "null explicitly leaves this interface unclassified.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "reason"
      ],
      "type": "object"
    },
    "PreviewIssue": {
      "properties": {
        "code": {
          "type": "string"
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "PreviewMetrics": {
      "properties": {
        "assigned_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "directories": {
          "items": {
            "$ref": "#/$defs/DirectoryCounts"
          },
          "type": "array"
        },
        "directory_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "logical_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_depth": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "snapshot_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unclassified_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unclassified_ratio": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "snapshot_interfaces",
        "assigned_interfaces",
        "unclassified_interfaces",
        "unclassified_ratio",
        "directory_count",
        "max_depth",
        "directories"
      ],
      "type": "object"
    },
    "PreviewNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "type": "object"
    },
    "PreviewReview": {
      "properties": {
        "issues": {
          "items": {
            "$ref": "#/$defs/PreviewIssue"
          },
          "type": "array"
        },
        "metrics": {
          "$ref": "#/$defs/PreviewMetrics"
        },
        "structurally_valid": {
          "description": "Structural validity only; never a claim of semantic quality or publication approval.",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/PreviewIssue"
          },
          "type": "array"
        }
      },
      "required": [
        "structurally_valid",
        "issues",
        "warnings",
        "metrics"
      ],
      "type": "object"
    },
    "PreviewStatus": {
      "enum": [
        "pending",
        "running",
        "ready",
        "rejected",
        "failed"
      ],
      "type": "string"
    },
    "PreviewTask": {
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectoryCandidate"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_id": {
          "format": "uuid",
          "type": "string"
        },
        "contract_version": {
          "type": "string"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "format": "int64",
          "type": "integer"
        },
        "generator": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreviewReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot": {
          "$ref": "#/$defs/CatalogSnapshot"
        },
        "snapshot_at": {
          "type": "string"
        },
        "snapshot_sha256": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PreviewStatus"
        },
        "task_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "candidate_id",
        "contract_version",
        "status",
        "snapshot_at",
        "snapshot_sha256",
        "snapshot",
        "generation"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "published": {
      "description": "True only when this candidate is the currently active official version.",
      "type": "boolean"
    },
    "task": {
      "$ref": "#/$defs/PreviewTask"
    }
  },
  "required": [
    "published",
    "task"
  ],
  "title": "CatalogPreviewDetail",
  "type": "object"
}
