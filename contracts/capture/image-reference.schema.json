      "type": [
        "string",
        "null"
      ]
    },
    "viewport_height": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "viewport_width": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "asset_id",
    "viewport_width",
    "viewport_height",
    "device_pixel_ratio",
    "complete",
    "limitations"
