{
  "$defs": {
    "CaptureContext": {
      "additionalProperties": false,
      "properties": {
        "browser_instance_id": {
          "format": "uuid",
          "type": "string"
        },
        "event_seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "frame_instance_id": {
          "format": "uuid",
          "type": "string"
        },
        "interaction_id": {
          "default": null,
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "page_instance_id": {
          "format": "uuid",
          "type": "string"
        },
        "page_url": {
          "type": "string"
        },
        "request_started_at_ms": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "response_completed_at_ms": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "view_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "browser_instance_id",
        "page_instance_id",
        "frame_instance_id",
        "view_id",
        "event_seq",
        "page_url"
      ],
      "type": "object"
    },
    "CaptureKind": {
      "enum": [
        "http_exchange",
        "page_context",
        "interaction",
        "ui_snapshot",
        "image_reference"
      ],
      "type": "string"
    },
    "Headers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "page-visible",
            "complete",
            "truncated",
            "unreadable"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "maxLength": 8192
              },
              {
                "type": "string",
                "maxLength": 65536
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "maxItems": 256
        }
      },
      "required": [
        "state",
        "entries"
      ]
    },
    "Body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "none",
            "complete",
            "truncated",
            "unreadable",
            "timeout"
          ]
        },
        "encoding": {
          "type": "string",
          "enum": [
            "text",
            "base64",
            "none"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 1500000
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "state",
        "encoding",
        "content",
        "bytes"
      ]
    },
    "HttpExchange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "maxLength": 16384
            },
            "url_truncated": {
              "type": "boolean"
            },
            "method": {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "HEAD",
                "OPTIONS",
                "CONNECT",
                "TRACE"
              ]
            },
            "headers": {
              "$ref": "#/$defs/Headers"
            },
            "body": {
              "$ref": "#/$defs/Body"
            }
          },
          "required": [
            "url",
            "url_truncated",
            "method",
            "headers",
            "body"
          ]
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "complete",
                "truncated",
                "unreadable",
                "failed",
                "timeout"
              ]
            },
            "status": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "type": "string",
              "maxLength": 16384
            },
            "headers": {
              "$ref": "#/$defs/Headers"
            },
            "body": {
              "$ref": "#/$defs/Body"
            }
          },
          "required": [
            "state",
            "status",
            "url",
            "headers",
            "body"
          ]
        },
        "source_page": {
          "type": "string",
          "maxLength": 16384
        },
        "transport": {
          "type": "string",
          "enum": [
            "xhr",
            "fetch",
            "other"
          ]
        },
        "frame": {
          "type": "string",
          "enum": [
            "page",
            "iframe",
            "other"
          ]
        }
      },
      "required": [
        "request",
        "response"
      ]
    },
    "ImageReferencePayload": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "device_pixel_ratio": {
          "format": "double",
          "type": "number"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "trigger_record_id": {
          "default": null,
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "viewport_height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "viewport_width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "viewport_width",
        "viewport_height",
        "device_pixel_ratio",
        "complete",
        "limitations"
      ],
      "title": "ImageReferencePayload",
      "type": "object"
    },
    "ElementBounds": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "InteractionAction": {
      "enum": [
        "click",
        "change",
        "submit"
      ],
      "type": "string"
    },
    "UiElement": {
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/ElementBounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "element_id": {
          "type": "string"
        },
        "label": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "items": {
            "$ref": "#/$defs/UiOption"
          },
          "type": "array"
        },
        "role": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/UiValue"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "element_id",
        "tag",
        "value",
        "options",
        "visible"
      ],
      "type": "object"
    },
    "UiOption": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "selected": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/UiValue"
        }
      },
      "required": [
        "label",
        "value",
        "selected"
      ],
      "type": "object"
    },
    "UiValue": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/UiValueState"
        },
        "value": true
      },
      "required": [
        "state",
        "value"
      ],
      "type": "object"
    },
    "UiValueState": {
      "enum": [
        "present",
        "omitted",
        "unknown"
      ],
      "type": "string"
    },
    "InteractionPayload": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/InteractionAction"
        },
        "complete": {
          "type": "boolean"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/UiElement"
        }
      },
      "required": [
        "action",
        "target",
        "complete",
        "limitations"
      ],
      "title": "InteractionPayload",
      "type": "object"
    },
    "PageContextPayload": {
      "additionalProperties": false,
      "properties": {
        "breadcrumbs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "complete": {
          "type": "boolean"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "regions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "title",
        "breadcrumbs",
        "regions",
        "complete",
        "limitations"
      ],
      "title": "PageContextPayload",
      "type": "object"
    },
    "UiSnapshotPayload": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/UiElement"
          },
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "elements",
        "complete",
        "limitations"
      ],
      "title": "UiSnapshotPayload",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaptureContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "$ref": "#/$defs/CaptureKind"
    },
    "payload": true,
    "payload_version": {
      "const": "1"
    },
    "record_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "kind",
    "payload_version",
    "captured_at",
    "payload"
  ],
  "title": "CaptureRecord",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "http_exchange"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/HttpExchange"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "page_context"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/PageContextPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "interaction"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/InteractionPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ui_snapshot"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/UiSnapshotPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "image_reference"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ImageReferencePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "page_context",
              "interaction",
              "ui_snapshot",
              "image_reference"
            ]
          }
        }
      },
      "then": {
        "required": [
          "context"
        ],
        "properties": {
          "context": {
            "$ref": "#/$defs/CaptureContext"
          }
        }
      }
    }
  ]
}
