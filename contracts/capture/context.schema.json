{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "browser_instance_id": {
      "format": "uuid",
      "type": "string"
    },
    "event_seq": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "frame_instance_id": {
      "format": "uuid",
      "type": "string"
    },
    "interaction_id": {
      "default": null,
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "page_instance_id": {
      "format": "uuid",
      "type": "string"
    },
    "page_url": {
      "type": "string"
    },
    "request_started_at_ms": {
      "default": null,
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "response_completed_at_ms": {
      "default": null,
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "view_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "browser_instance_id",
    "page_instance_id",
    "frame_instance_id",
    "view_id",
    "event_seq",
    "page_url"
