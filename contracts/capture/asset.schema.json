{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "asset_id": {
      "format": "uuid",
      "type": "string"
    },
    "bytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "media_type": {
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "type": "string"
    },
    "replayed": {
      "type": "boolean"
    },
    "sha256": {
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "project_id",
    "sha256",
    "bytes",
    "media_type",
    "replayed"
  ],
  "title": "AssetReceipt",
  "type": "object"
}
