{
  "$defs": {
    "CaptureContext": {
      "additionalProperties": false,
      "properties": {
        "browser_instance_id": {
          "format": "uuid",
          "type": "string"
        },
        "event_seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "frame_instance_id": {
          "format": "uuid",
          "type": "string"
        },
        "interaction_id": {
          "default": null,
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "page_instance_id": {
          "format": "uuid",
          "type": "string"
        },
        "page_url": {
          "type": "string"
        },
        "request_started_at_ms": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "response_completed_at_ms": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "view_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "browser_instance_id",
        "page_instance_id",
        "frame_instance_id",
        "view_id",
        "event_seq",
        "page_url"
      ],
      "type": "object"
    },
    "CaptureKind": {
      "enum": [
        "http_exchange",
        "page_context",
        "interaction",
        "ui_snapshot",
        "image_reference"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actor_id": {
      "format": "uuid",
      "type": "string"
    },
    "captured_at": {
      "type": "string"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaptureContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment_id": {
      "format": "uuid",
      "type": "string"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_status": {
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "type": "string"
    },
    "ingestion_id": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "$ref": "#/$defs/CaptureKind"
    },
    "payload": true,
    "payload_available": {
      "type": "boolean"
    },
    "project_id": {
      "format": "uuid",
      "type": "string"
    },
    "record_id": {
      "format": "uuid",
      "type": "string"
    },
    "structure": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "environment_id",
    "kind",
    "record_id",
    "actor_id",
    "captured_at",
    "structure",
    "evidence_status",
    "payload_available"
  ],
  "title": "CaptureObservation",
  "type": "object"
}
