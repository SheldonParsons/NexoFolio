{
  "$defs": {
    "ElementBounds": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "InteractionAction": {
      "enum": [
        "click",
        "change",
        "submit"
      ],
      "type": "string"
    },
    "UiElement": {
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/ElementBounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "element_id": {
          "type": "string"
        },
        "label": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "items": {
            "$ref": "#/$defs/UiOption"
          },
          "type": "array"
        },
        "role": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/UiValue"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "element_id",
        "tag",
        "value",
        "options",
        "visible"
      ],
      "type": "object"
    },
    "UiOption": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "selected": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/UiValue"
        }
      },
      "required": [
        "label",
        "value",
        "selected"
      ],
      "type": "object"
    },
    "UiValue": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/UiValueState"
        },
        "value": true
      },
      "required": [
        "state",
        "value"
      ],
      "type": "object"
    },
    "UiValueState": {
      "enum": [
        "present",
        "omitted",
        "unknown"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/InteractionAction"
    },
    "complete": {
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "target": {
      "$ref": "#/$defs/UiElement"
    }
  },
  "required": [
    "action",
    "target",
    "complete",
    "limitations"
  ],
  "title": "InteractionPayload",
  "type": "object"
}
