{
  "$defs": {
    "AnnotationDraft": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/KnowledgeEvidenceRef"
          },
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/SemanticTarget"
        },
        "value": {
          "$ref": "#/$defs/SemanticValue"
        },
        "verification": {
          "$ref": "#/$defs/Verification"
        }
      },
      "required": [
        "id",
        "target",
        "value",
        "evidence",
        "verification",
        "note"
      ],
      "type": "object"
    },
    "DefinitionBasis": {
      "properties": {
        "environment_id": {
          "format": "uuid",
          "type": "string"
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "environment_id",
        "revision_id"
      ],
      "type": "object"
    },
    "DirectoryCandidate": {
      "additionalProperties": false,
      "properties": {
        "assignments": {
          "items": {
            "$ref": "#/$defs/PreviewAssignment"
          },
          "type": "array"
        },
        "merge_groups": {
          "items": {
            "$ref": "#/$defs/InterfaceMergeGroup"
          },
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/PreviewNode"
          },
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "assignments"
      ],
      "type": "object"
    },
    "DirectoryCounts": {
      "properties": {
        "direct_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "directory_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "directory_id",
        "direct_interfaces"
      ],
      "type": "object"
    },
    "EnumEntry": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/UiValueState"
        },
        "value": true
      },
      "required": [
        "state",
        "value"
      ],
      "type": "object"
    },
    "FieldRef": {
      "additionalProperties": false,
      "properties": {
        "environment_id": {
          "format": "uuid",
          "type": "string"
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "environment_id",
        "revision_id",
        "location",
        "path"
      ],
      "type": "object"
    },
    "InterfaceMergeGroup": {
      "additionalProperties": false,
      "properties": {
        "member_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "path_template": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "representative_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "representative_id",
        "member_ids",
        "path_template",
        "reason"
      ],
      "type": "object"
    },
    "KnowledgeEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/KnowledgeReferenceKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "KnowledgeReferenceKind": {
      "enum": [
        "field",
        "fact",
        "interface",
        "directory",
        "image",
        "summary",
        "annotation",
        "observation",
        "source"
      ],
      "type": "string"
    },
    "MaintenanceAction": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "items": {
                "$ref": "#/$defs/KnowledgeEvidenceRef"
              },
              "type": "array"
            },
            "kind": {
              "const": "set_directory",
              "type": "string"
            },
            "node": {
              "$ref": "#/$defs/PreviewNode"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "node",
            "reason",
            "evidence"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "directory_id": {
              "format": "uuid",
              "type": "string"
            },
            "evidence": {
              "items": {
                "$ref": "#/$defs/KnowledgeEvidenceRef"
              },
              "type": "array"
            },
            "kind": {
              "const": "remove_directory",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "directory_id",
            "reason",
            "evidence"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "directory_id": {
              "format": "uuid",
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "items": {
                "$ref": "#/$defs/KnowledgeEvidenceRef"
              },
              "type": "array"
            },
            "interface_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "assign_interface",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "interface_id",
            "reason",
            "evidence"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "candidate": {
              "$ref": "#/$defs/DirectoryCandidate"
            },
            "evidence": {
              "items": {
                "$ref": "#/$defs/KnowledgeEvidenceRef"
              },
              "type": "array"
            },
            "kind": {
              "const": "replace_catalog",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "candidate",
            "reason",
            "evidence"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "items": {
                "$ref": "#/$defs/KnowledgeEvidenceRef"
              },
              "type": "array"
            },
            "group": {
              "$ref": "#/$defs/InterfaceMergeGroup"
            },
            "kind": {
              "const": "upsert_merge_group",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "group",
            "reason",
            "evidence"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "items": {
                "$ref": "#/$defs/KnowledgeEvidenceRef"
              },
              "type": "array"
            },
            "kind": {
              "const": "remove_merge_group",
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "representative_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "representative_id",
            "reason",
            "evidence"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "annotation": {
              "$ref": "#/$defs/AnnotationDraft"
            },
            "kind": {
              "const": "upsert_annotation",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "annotation",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "annotation_id": {
              "format": "uuid",
              "type": "string"
            },
            "evidence": {
              "items": {
                "$ref": "#/$defs/KnowledgeEvidenceRef"
              },
              "type": "array"
            },
            "kind": {
              "const": "retract_annotation",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "annotation_id",
            "reason",
            "evidence"
          ],
          "type": "object"
        }
      ]
    },
    "MaintenancePlan": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/MaintenanceAction"
          },
          "type": "array"
        },
        "expected_benefit": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/MaintenanceStrategy"
        }
      },
      "required": [
        "strategy",
        "reason",
        "expected_benefit",
        "actions"
      ],
      "type": "object"
    },
    "MaintenanceStrategy": {
      "enum": [
        "keep",
        "insert",
        "partial",
        "full"
      ],
      "type": "string"
    },
    "PreviewAssignment": {
      "additionalProperties": false,
      "properties": {
        "directory_id": {
          "description": "null explicitly leaves this interface unclassified.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "reason"
      ],
      "type": "object"
    },
    "PreviewIssue": {
      "properties": {
        "code": {
          "type": "string"
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "PreviewMetrics": {
      "properties": {
        "assigned_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "directories": {
          "items": {
            "$ref": "#/$defs/DirectoryCounts"
          },
          "type": "array"
        },
        "directory_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "logical_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_depth": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "snapshot_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unclassified_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unclassified_ratio": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "snapshot_interfaces",
        "assigned_interfaces",
        "unclassified_interfaces",
        "unclassified_ratio",
        "directory_count",
        "max_depth",
        "directories"
      ],
      "type": "object"
    },
    "PreviewNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "type": "object"
    },
    "PreviewReview": {
      "properties": {
        "issues": {
          "items": {
            "$ref": "#/$defs/PreviewIssue"
          },
          "type": "array"
        },
        "metrics": {
          "$ref": "#/$defs/PreviewMetrics"
        },
        "structurally_valid": {
          "description": "Structural validity only; never a claim of semantic quality or publication approval.",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/PreviewIssue"
          },
          "type": "array"
        }
      },
      "required": [
        "structurally_valid",
        "issues",
        "warnings",
        "metrics"
      ],
      "type": "object"
    },
    "ReviewCoverage": {
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "completed_segments": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "reviewed_fields": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "total_fields": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "total_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "total_segments": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total_interfaces",
        "total_fields",
        "reviewed_fields",
        "total_segments",
        "completed_segments",
        "complete"
      ],
      "type": "object"
    },
    "SemanticAnnotation": {
      "properties": {
        "annotation": {
          "$ref": "#/$defs/AnnotationDraft"
        },
        "basis": {
          "items": {
            "$ref": "#/$defs/DefinitionBasis"
          },
          "type": "array"
        },
        "source_run_id": {
          "format": "uuid",
          "type": "string"
        },
        "stale": {
          "type": "boolean"
        }
      },
      "required": [
        "annotation",
        "basis",
        "source_run_id",
        "stale"
      ],
      "type": "object"
    },
    "SemanticTarget": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "interface_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "interface",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "interface_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "$ref": "#/$defs/FieldRef"
            },
            "kind": {
              "const": "field",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "field"
          ],
          "type": "object"
        }
      ]
    },
    "SemanticValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "description",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "conditions": true,
            "kind": {
              "const": "parameter_relation",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/FieldRef"
            },
            "target": {
              "$ref": "#/$defs/FieldRef"
            },
            "transform": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source",
            "target",
            "transform",
            "conditions"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "entries": {
              "items": {
                "$ref": "#/$defs/EnumEntry"
              },
              "type": "array"
            },
            "kind": {
              "const": "enum",
              "type": "string"
            },
            "scope": true
          },
          "required": [
            "kind",
            "entries",
            "complete",
            "scope"
          ],
          "type": "object"
        }
      ]
    },
    "UiValueState": {
      "enum": [
        "present",
        "omitted",
        "unknown"
      ],
      "type": "string"
    },
    "Verification": {
      "enum": [
        "observed",
        "inferred",
        "needs_review"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "annotations": {
      "items": {
        "$ref": "#/$defs/SemanticAnnotation"
      },
      "type": "array"
    },
    "catalog": {
      "$ref": "#/$defs/DirectoryCandidate"
    },
    "coverage": {
      "$ref": "#/$defs/ReviewCoverage"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "plan": {
      "$ref": "#/$defs/MaintenancePlan"
    },
    "review": {
      "$ref": "#/$defs/PreviewReview"
    }
  },
  "required": [
    "plan",
    "catalog",
    "annotations",
    "review",
    "coverage",
    "issues"
  ],
  "title": "MaintenanceCandidate",
  "type": "object"
}
