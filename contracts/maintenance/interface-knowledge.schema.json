{
  "$defs": {
    "AnnotationDraft": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/KnowledgeEvidenceRef"
          },
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/SemanticTarget"
        },
        "value": {
          "$ref": "#/$defs/SemanticValue"
        },
        "verification": {
          "$ref": "#/$defs/Verification"
        }
      },
      "required": [
        "id",
        "target",
        "value",
        "evidence",
        "verification",
        "note"
      ],
      "type": "object"
    },
    "DefinitionBasis": {
      "properties": {
        "environment_id": {
          "format": "uuid",
          "type": "string"
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "environment_id",
        "revision_id"
      ],
      "type": "object"
    },
    "EnumEntry": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/UiValueState"
        },
        "value": true
      },
      "required": [
        "state",
        "value"
      ],
      "type": "object"
    },
    "FieldRef": {
      "additionalProperties": false,
      "properties": {
        "environment_id": {
          "format": "uuid",
          "type": "string"
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "environment_id",
        "revision_id",
        "location",
        "path"
      ],
      "type": "object"
    },
    "KnowledgeEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/KnowledgeReferenceKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "KnowledgeReferenceKind": {
      "enum": [
        "field",
        "fact",
        "interface",
        "directory",
        "image",
        "summary",
        "annotation",
        "observation",
        "source"
      ],
      "type": "string"
    },
    "SemanticAnnotation": {
      "properties": {
        "annotation": {
          "$ref": "#/$defs/AnnotationDraft"
        },
        "basis": {
          "items": {
            "$ref": "#/$defs/DefinitionBasis"
          },
          "type": "array"
        },
        "source_run_id": {
          "format": "uuid",
          "type": "string"
        },
        "stale": {
          "type": "boolean"
        }
      },
      "required": [
        "annotation",
        "basis",
        "source_run_id",
        "stale"
      ],
      "type": "object"
    },
    "SemanticTarget": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "interface_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "interface",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "interface_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "$ref": "#/$defs/FieldRef"
            },
            "kind": {
              "const": "field",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "field"
          ],
          "type": "object"
        }
      ]
    },
    "SemanticValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "description",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "conditions": true,
            "kind": {
              "const": "parameter_relation",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/FieldRef"
            },
            "target": {
              "$ref": "#/$defs/FieldRef"
            },
            "transform": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source",
            "target",
            "transform",
            "conditions"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "entries": {
              "items": {
                "$ref": "#/$defs/EnumEntry"
              },
              "type": "array"
            },
            "kind": {
              "const": "enum",
              "type": "string"
            },
            "scope": true
          },
          "required": [
            "kind",
            "entries",
            "complete",
            "scope"
          ],
          "type": "object"
        }
      ]
    },
    "UiValueState": {
      "enum": [
        "present",
        "omitted",
        "unknown"
      ],
      "type": "string"
    },
    "Verification": {
      "enum": [
        "observed",
        "inferred",
        "needs_review"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "annotations": {
      "items": {
        "$ref": "#/$defs/SemanticAnnotation"
      },
      "type": "array"
    },
    "environment_id": {
      "format": "uuid",
      "type": "string"
    },
    "generation": {
      "format": "int64",
      "type": "integer"
    },
    "interface_id": {
      "format": "uuid",
      "type": "string"
    },
    "knowledge_version_id": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "revision_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "interface_id",
    "environment_id",
    "revision_id",
    "generation",
    "annotations"
  ],
  "title": "InterfaceKnowledge",
  "type": "object"
}
