{
  "$defs": {
    "FieldAssessment": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "$ref": "#/$defs/FieldReviewDisposition"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/KnowledgeEvidenceRef"
          },
          "type": "array"
        },
        "field_id": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "unit_id": {
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "field_id",
        "disposition",
        "note",
        "evidence"
      ],
      "type": "object"
    },
    "FieldReviewDisposition": {
      "enum": [
        "keep",
        "change",
        "conflict",
        "needs_evidence"
      ],
      "type": "string"
    },
    "KnowledgeEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/KnowledgeReferenceKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "KnowledgeReferenceKind": {
      "enum": [
        "field",
        "fact",
        "interface",
        "directory",
        "image",
        "summary",
        "annotation"
      ],
      "type": "string"
    },
    "MaintenanceCheckpoint": {
      "properties": {
        "data": true,
        "id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/KnowledgeEvidenceRef"
          },
          "type": "array"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/SegmentReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "phase",
        "references",
        "data"
      ],
      "type": "object"
    },
    "SegmentReview": {
      "additionalProperties": false,
      "properties": {
        "assessments": {
          "items": {
            "$ref": "#/$defs/FieldAssessment"
          },
          "type": "array"
        },
        "segment_id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "assessments",
        "summary"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/MaintenanceCheckpoint"
      },
      "type": "array"
    },
    "limit": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "page": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "total": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "total",
    "page",
    "limit"
  ],
  "title": "MaintenanceCheckpointPage",
  "type": "object"
}
