{
  "$defs": {
    "AnnotationDraft": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/KnowledgeEvidenceRef"
          },
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/SemanticTarget"
        },
        "value": {
          "$ref": "#/$defs/SemanticValue"
        },
        "verification": {
          "$ref": "#/$defs/Verification"
        }
      },
      "required": [
        "id",
        "target",
        "value",
        "evidence",
        "verification",
        "note"
      ],
      "type": "object"
    },
    "AssessmentKind": {
      "enum": [
        "duplicate",
        "enrichment",
        "difference",
        "insufficient"
      ],
      "type": "string"
    },
    "CaptureContext": {
      "additionalProperties": false,
      "properties": {
        "browser_instance_id": {
          "format": "uuid",
          "type": "string"
        },
        "event_seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "frame_instance_id": {
          "format": "uuid",
          "type": "string"
        },
        "interaction_id": {
          "default": null,
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "page_instance_id": {
          "format": "uuid",
          "type": "string"
        },
        "page_url": {
          "type": "string"
        },
        "request_started_at_ms": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "response_completed_at_ms": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "view_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "browser_instance_id",
        "page_instance_id",
        "frame_instance_id",
        "view_id",
        "event_seq",
        "page_url"
      ],
      "type": "object"
    },
    "CatalogEnvironment": {
      "additionalProperties": false,
      "properties": {
        "definition": true,
        "environment_id": {
          "format": "uuid",
          "type": "string"
        },
        "environment_name": {
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "environment_id",
        "environment_name",
        "revision_id",
        "definition"
      ],
      "type": "object"
    },
    "CatalogInterface": {
      "additionalProperties": false,
      "properties": {
        "environments": {
          "items": {
            "$ref": "#/$defs/CatalogEnvironment"
          },
          "type": "array"
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "recognized_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "interface_id",
        "method",
        "path",
        "environments"
      ],
      "type": "object"
    },
    "DefinitionBasis": {
      "properties": {
        "environment_id": {
          "format": "uuid",
          "type": "string"
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "environment_id",
        "revision_id"
      ],
      "type": "object"
    },
    "DirectoryCandidate": {
      "additionalProperties": false,
      "properties": {
        "assignments": {
          "items": {
            "$ref": "#/$defs/PreviewAssignment"
          },
          "type": "array"
        },
        "merge_groups": {
          "items": {
            "$ref": "#/$defs/InterfaceMergeGroup"
          },
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/PreviewNode"
          },
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "assignments"
      ],
      "type": "object"
    },
    "DirectoryCounts": {
      "properties": {
        "direct_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "directory_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "directory_id",
        "direct_interfaces"
      ],
      "type": "object"
    },
    "EnumEntry": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/UiValueState"
        },
        "value": true
      },
      "required": [
        "state",
        "value"
      ],
      "type": "object"
    },
    "EvidenceFact": {
      "properties": {
        "data": true,
        "environment_id": {
          "format": "uuid",
          "type": "string"
        },
        "first_seen": {
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "last_seen": {
          "type": "string"
        },
        "observations": {
          "format": "int64",
          "type": "integer"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        },
        "samples": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "subject": true
      },
      "required": [
        "id",
        "project_id",
        "environment_id",
        "kind",
        "subject",
        "data",
        "observations",
        "first_seen",
        "last_seen",
        "samples"
      ],
      "type": "object"
    },
    "EvidenceFieldRef": {
      "description": "Evidence may describe an unadopted field. Exactly one basis is populated by the extractor.\nAdopted references serialize as the existing FieldRef; observation references never claim a revision.",
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "environment_id": {
              "format": "uuid",
              "type": "string"
            },
            "interface_id": {
              "format": "uuid",
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "revision_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "interface_id",
            "environment_id",
            "location",
            "path",
            "revision_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "environment_id": {
              "format": "uuid",
              "type": "string"
            },
            "interface_id": {
              "format": "uuid",
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "observation": {
              "$ref": "#/$defs/ObservationFieldRef"
            }
          },
          "required": [
            "interface_id",
            "environment_id",
            "location",
            "path",
            "observation"
          ],
          "additionalProperties": false
        }
      ]
    },
    "FieldRef": {
      "additionalProperties": false,
      "properties": {
        "environment_id": {
          "format": "uuid",
          "type": "string"
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "environment_id",
        "revision_id",
        "location",
        "path"
      ],
      "type": "object"
    },
    "InterfaceMergeGroup": {
      "additionalProperties": false,
      "properties": {
        "member_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "path_template": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "representative_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "representative_id",
        "member_ids",
        "path_template",
        "reason"
      ],
      "type": "object"
    },
    "KnowledgeEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/KnowledgeReferenceKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "KnowledgeField": {
      "properties": {
        "ancestors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "existing_annotations": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/EvidenceFieldRef"
        },
        "schema": true,
        "schema_pointers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "reference",
        "schema",
        "schema_pointers",
        "ancestors",
        "existing_annotations"
      ],
      "type": "object"
    },
    "KnowledgeReferenceKind": {
      "enum": [
        "field",
        "fact",
        "interface",
        "directory",
        "image",
        "summary",
        "annotation",
        "observation",
        "source"
      ],
      "type": "string"
    },
    "ObservationAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructuralAssessment"
            },
            {
              "type": "null"
            }
          ],
          "description": "None means historical data not assessed by this rule; it never means duplicate."
        },
        "base_revision_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "environment_id": {
          "format": "uuid",
          "type": "string"
        },
        "extractor_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "incoming_definition": true,
        "ingestion_id": {
          "description": "Source of the incoming structure, not a claim that new fields belong to base_revision_id.",
          "format": "uuid",
          "type": "string"
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "interface_id",
        "environment_id",
        "ingestion_id"
      ],
      "type": "object"
    },
    "ObservationFieldRef": {
      "additionalProperties": false,
      "description": "Field observed in an input, deliberately without an adopted revision ID.",
      "properties": {
        "environment_id": {
          "format": "uuid",
          "type": "string"
        },
        "ingestion_id": {
          "format": "uuid",
          "type": "string"
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "interface_id",
        "environment_id",
        "ingestion_id",
        "location",
        "path"
      ],
      "type": "object"
    },
    "PathIdentity": {
      "properties": {
        "parameters": {
          "items": {
            "$ref": "#/$defs/PathParameter"
          },
          "type": "array"
        },
        "rule_version": {
          "type": "string"
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
        "rule_version",
        "template",
        "parameters"
      ],
      "type": "object"
    },
    "PathParameter": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/PathParameterKind"
        },
        "name": {
          "type": "string"
        },
        "segment_index": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "segment_index",
        "kind"
      ],
      "type": "object"
    },
    "PathParameterKind": {
      "enum": [
        "uuid",
        "hex32",
        "hex64",
        "integer"
      ],
      "type": "string"
    },
    "PreviewAssignment": {
      "additionalProperties": false,
      "properties": {
        "directory_id": {
          "description": "null explicitly leaves this interface unclassified.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "interface_id": {
          "format": "uuid",
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "reason"
      ],
      "type": "object"
    },
    "PreviewMetrics": {
      "properties": {
        "assigned_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "directories": {
          "items": {
            "$ref": "#/$defs/DirectoryCounts"
          },
          "type": "array"
        },
        "directory_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "logical_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_depth": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "snapshot_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unclassified_interfaces": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unclassified_ratio": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "snapshot_interfaces",
        "assigned_interfaces",
        "unclassified_interfaces",
        "unclassified_ratio",
        "directory_count",
        "max_depth",
        "directories"
      ],
      "type": "object"
    },
    "PreviewNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "type": "object"
    },
    "SemanticAnnotation": {
      "properties": {
        "annotation": {
          "$ref": "#/$defs/AnnotationDraft"
        },
        "basis": {
          "items": {
            "$ref": "#/$defs/DefinitionBasis"
          },
          "type": "array"
        },
        "source_run_id": {
          "format": "uuid",
          "type": "string"
        },
        "stale": {
          "type": "boolean"
        }
      },
      "required": [
        "annotation",
        "basis",
        "source_run_id",
        "stale"
      ],
      "type": "object"
    },
    "SemanticTarget": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "interface_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "interface",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "interface_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "$ref": "#/$defs/FieldRef"
            },
            "kind": {
              "const": "field",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "field"
          ],
          "type": "object"
        }
      ]
    },
    "SemanticValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "description",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "conditions": true,
            "kind": {
              "const": "parameter_relation",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/FieldRef"
            },
            "target": {
              "$ref": "#/$defs/FieldRef"
            },
            "transform": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source",
            "target",
            "transform",
            "conditions"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "entries": {
              "items": {
                "$ref": "#/$defs/EnumEntry"
              },
              "type": "array"
            },
            "kind": {
              "const": "enum",
              "type": "string"
            },
            "scope": true
          },
          "required": [
            "kind",
            "entries",
            "complete",
            "scope"
          ],
          "type": "object"
        }
      ]
    },
    "SnapshotInputs": {
      "properties": {
        "gaps": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Explicit, version-independent diagnostic counts, never a claim that a model has read anything.",
          "type": "object"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/SnapshotObservation"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SnapshotSource"
          },
          "type": "array"
        }
      },
      "required": [
        "observations",
        "sources",
        "gaps"
      ],
      "type": "object"
    },
    "SnapshotObservation": {
      "description": "Stored comparison is preserved; historical raw re-extraction is separate, read-only material.",
      "properties": {
        "reconstructed_definition": true,
        "record": {
          "$ref": "#/$defs/ObservationAssessment"
        }
      },
      "required": [
        "record"
      ],
      "type": "object"
    },
    "SnapshotSource": {
      "properties": {
        "actor_id": {
          "format": "uuid",
          "type": "string"
        },
        "captured_at": {
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment_id": {
          "format": "uuid",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "type": "string"
        },
        "evidence_coverage": true,
        "evidence_status": {
          "type": "string"
        },
        "ingestion_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "producer_id": {
          "format": "uuid",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        },
        "raw_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "project_id",
        "environment_id",
        "actor_id",
        "producer_id",
        "record_id",
        "kind",
        "captured_at",
        "evidence_status"
      ],
      "type": "object"
    },
    "StructuralAssessment": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/AssessmentKind"
          },
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/StructuralFinding"
          },
          "type": "array"
        },
        "initial": {
          "type": "boolean"
        },
        "rule_version": {
          "type": "string"
        }
      },
      "required": [
        "rule_version",
        "initial",
        "categories",
        "findings"
      ],
      "type": "object"
    },
    "StructuralFinding": {
      "additionalProperties": false,
      "properties": {
        "before": true,
        "kind": {
          "$ref": "#/$defs/AssessmentKind"
        },
        "location": {
          "type": "string"
        },
        "observed": true,
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "location",
        "path",
        "reason"
      ],
      "type": "object"
    },
    "UiValueState": {
      "enum": [
        "present",
        "omitted",
        "unknown"
      ],
      "type": "string"
    },
    "Verification": {
      "enum": [
        "observed",
        "inferred",
        "needs_review"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "annotations": {
      "items": {
        "$ref": "#/$defs/SemanticAnnotation"
      },
      "type": "array"
    },
    "base_catalog_version": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "base_generation": {
      "format": "int64",
      "type": "integer"
    },
    "base_knowledge_version": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "catalog": {
      "$ref": "#/$defs/DirectoryCandidate"
    },
    "directory_metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreviewMetrics"
        },
        {
          "type": "null"
        }
      ]
    },
