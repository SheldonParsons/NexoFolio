# For a local Rust process, use a PostgreSQL address reachable from this machine.
DATABASE_URL=postgres://nexofolio:CHANGE_ME@127.0.0.1:15432/nexofolio
NEXOFOLIO_BIND_ADDR=127.0.0.1:8080
NEXOFOLIO_DB_MAX_CONNECTIONS=5
NEXOFOLIO_DB_TIMEOUT_MS=1500
NEXOFOLIO_REQUEST_TIMEOUT_MS=60000
NEXOFOLIO_SHUTDOWN_TIMEOUT_MS=5000
NEXOFOLIO_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
NEXOFOLIO_MCP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
NEXOFOLIO_LOG=info

# Set both to enable login/project routes. Keep the generated key across restarts.
NEXOFOLIO_ZENTAO_BASE_URL=
NEXOFOLIO_SESSION_KEY=
# Optional Argon2id PHC hash; never put an actual password in this template.
NEXOFOLIO_EMERGENCY_PASSWORD_HASH=

# Optional OpenAI-compatible model for endpoint descriptions and directory curation.
# The base URL must precede /chat/completions. Export these for the Rust process.
# start-nexofolio.sh also loads deploy/.env.catalog-model and can read a key from
# NEXOFOLIO_CATALOG_MODEL_KEY_HOST_FILE. Keep real keys out of version control.
NEXOFOLIO_CATALOG_MODEL_BASE_URL=
NEXOFOLIO_CATALOG_MODEL=
NEXOFOLIO_CATALOG_MODEL_API_KEY=

# Shared model ceiling; one admission controller backs off only for HTTP 429/503.
# Field workers use their configured capacity; local queue/timeout never reduces it.
NEXOFOLIO_MODEL_MAX_CONCURRENCY=8
NEXOFOLIO_FIELD_CONCURRENCY=8
NEXOFOLIO_DESCRIPTION_CONCURRENCY=4
# No total curation deadline; only inactivity ends an otherwise live execution.
NEXOFOLIO_CURATION_IDLE_SECONDS=900

# Optional provider controls: provider (omit), low, high, max, disabled.
# Enable only after verifying support and quality on the configured gateway.
NEXOFOLIO_MODEL_THINKING=provider
NEXOFOLIO_MODEL_JSON_OUTPUT=false
