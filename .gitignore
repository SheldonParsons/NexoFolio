# Rust build output (Cargo.lock is intentionally committed for this application).
target/
**/*.rs.bk

# Local configuration and credentials; keep templates reviewable.
.env
.env.*
!.env.example
/deploy/.env
/secrets/
*.key
*.pem
*.p12
*.pfx

# Runtime data, database backups and generated experiment results.
/data/
/backups/
/tmp/
/experiments/results/
*.dump
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Test/coverage artifacts and helper-script caches.
/coverage/
/test-results/
*.profraw
*.profdata
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Promo video assets and drafts (not part of the backend project).
/promo/
/video-assets/
/docs/promo-video-codex-prompt.md
/shot1_start.png
/shot1_end.png
/music_player.html
/music_player.jsx

# Local presentation/video experiments and their generated assets.
/.codex-ppt-build/
/presentations/
/NexoFolio-能力介绍.pptx
/NexoFolio-介绍.pptx
/.~*.pptx
/ppt-build-deck.js
/nexofolio-promo.html
/STORYBOARD.md
/style-preview.html
/style-demo-v*.html
/ref-frames/
/ref.mp4

# Local browser evaluation binary, unrelated to backend source.
/lightpanda

# Machine-specific launcher; keep the actual configuration on this machine.
/start-nexofolio.sh

# Local execution evidence and transient checkpoints. Existing tracked notes
# remain tracked; reusable contracts/specs belong in docs/architecture or handoff.
/docs/audits/
/docs/handoff/2026-10-07-overnight-checkpoint.json

# Editor/OS scratch files and runtime logs.
.idea/
.vscode/
*.swp
*.swo
*~
*.log
.DS_Store
Thumbs.db
