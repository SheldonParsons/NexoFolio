# Template only. Create .env on the target host with mode 0600.
# Use the same project/volume names for every subsequent update on that host.
COMPOSE_PROJECT_NAME=nexofolio-server
NEXOFOLIO_PLATFORM=linux/amd64
BACKEND_IMAGE=nexofolio-backend:REPLACE_WITH_RELEASE_ID
POSTGRES_IMAGE=postgres:17.4
NEXOFOLIO_PG_VOLUME=nexofolio-server-postgres
NEXOFOLIO_HTTP_PORT=18080

# Set both passwords to the same server-generated value; URL-encode in DATABASE_URL.
# These credentials initialize a NEW empty volume; they do not reset existing users.
POSTGRES_PASSWORD=REPLACE_ON_SERVER
DATABASE_URL=postgres://nexofolio:REPLACE_ON_SERVER@db:5432/nexofolio
NEXOFOLIO_LOG=info

# Configure both for login. Generate and retain a 32-byte session key (64 hex chars).
NEXOFOLIO_ZENTAO_BASE_URL=
NEXOFOLIO_SESSION_KEY=
# Single-quote a PHC hash in .env so Compose preserves literal dollar signs.
NEXOFOLIO_EMERGENCY_PASSWORD_HASH=

# Reachable Baitong/OpenAI-compatible endpoint, with the path before /chat/completions.
NEXOFOLIO_CATALOG_MODEL_BASE_URL=
NEXOFOLIO_CATALOG_MODEL=
NEXOFOLIO_CATALOG_MODEL_API_KEY=
# Optional provider controls. Flash + high: model=deepseek-v4-flash, thinking=high.
# provider leaves provider defaults intact; other modes: low, high, max, disabled.
NEXOFOLIO_MODEL_THINKING=provider
NEXOFOLIO_MODEL_JSON_OUTPUT=false
NEXOFOLIO_CURATION_IDLE_SECONDS=900
NEXOFOLIO_MODEL_MAX_CONCURRENCY=4
NEXOFOLIO_FIELD_CONCURRENCY=4
NEXOFOLIO_DESCRIPTION_CONCURRENCY=2

# Add the actual service host and origin when enabling the NGINX MCP entry.
NEXOFOLIO_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
NEXOFOLIO_MCP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Blank uses the application's OSS release defaults. Override for your allowed OSS.
NEXOFOLIO_FETCHER_RELEASE_DIR=
NEXOFOLIO_DESKTOP_INTERNAL_RELEASE_DIR=
NEXOFOLIO_DESKTOP_PUBLIC_RELEASE_DIR=

# Audit: fixed viewer account a80646. Only trust exact proxy peer IPs you control.
NEXOFOLIO_AUDIT_ENABLED=true
NEXOFOLIO_AUDIT_MAX_EVENTS=100000
NEXOFOLIO_AUDIT_MAX_BUCKETS=100000
NEXOFOLIO_AUDIT_OPERATION_DAYS=90
NEXOFOLIO_AUDIT_ERROR_DAYS=30
NEXOFOLIO_AUDIT_ACCESS_DAYS=30
NEXOFOLIO_AUDIT_TRUSTED_PROXIES=
