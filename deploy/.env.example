# Replace both placeholders with the same local database password before running.
# No real credentials belong in version control. URL-encode the password in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://nexofolio:CHANGE_ME@db:5432/nexofolio
NEXOFOLIO_HTTP_PORT=18080
NEXOFOLIO_DB_PORT=15432
NEXOFOLIO_LOG=info
NEXOFOLIO_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
NEXOFOLIO_MCP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Set together to enable login/projects. Generate a 32-byte key as 64 hex chars.
NEXOFOLIO_ZENTAO_BASE_URL=
NEXOFOLIO_SESSION_KEY=
# In Compose .env files, single-quote the PHC hash to preserve literal dollar signs.
NEXOFOLIO_EMERGENCY_PASSWORD_HASH=
